<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NaijaAgentX - Elite Conversational Recommender & User Simulator</title>
    <!-- Google Fonts Outfit & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for data science visualization -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-color: #05040a;
            --sidebar-bg: rgba(10, 8, 20, 0.75);
            --card-bg: rgba(18, 14, 34, 0.5);
            --border-color: rgba(124, 77, 255, 0.18);
            --border-hover: rgba(0, 229, 255, 0.45);

            --primary-glow: linear-gradient(135deg, #7c4dff 0%, #00e5ff 100%);
            --accent-purple: #8c5dff;
            --accent-cyan: #00e5ff;
            --accent-green: #00e676;
            --accent-red: #ff1744;
            --text-main: #f3f0ff;
            --text-muted: #8e85b7;
            --glass-backdrop: blur(20px);
            --terminal-bg: #030206;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Outfit', sans-serif;
            scrollbar-width: thin;
            scrollbar-color: var(--accent-purple) var(--bg-color);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-color);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(124, 77, 255, 0.35);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent-cyan);
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            height: 100vh;
            overflow: hidden;
            display: flex;
            background-image:
                radial-gradient(circle at 5% 15%, rgba(124, 77, 255, 0.12) 0%, transparent 45%),
                radial-gradient(circle at 90% 85%, rgba(0, 229, 255, 0.09) 0%, transparent 45%);
        }

        /* Main Container Layout */
        .app-container {
            display: flex;
            width: 100%;
            height: 100vh;
        }

        /* SIDEBAR USER LIST */
        .sidebar {
            width: 320px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            backdrop-filter: var(--glass-backdrop);
            display: flex;
            flex-direction: column;
            height: 100%;
            z-index: 10;
        }

        .sidebar-header {
            padding: 24px;
            border-bottom: 1px solid var(--border-color);
            background: linear-gradient(180deg, rgba(124, 77, 255, 0.12) 0%, transparent 100%);
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 22px;
            letter-spacing: 0.5px;
            background: var(--primary-glow);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar-logo i {
            -webkit-text-fill-color: var(--accent-cyan);
        }

        .sidebar-subtitle {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 4px;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            font-weight: 600;
        }

        .user-search {
            margin: 16px 20px;
            position: relative;
        }

        .user-search input {
            width: 100%;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            padding: 11px 14px 11px 38px;
            border-radius: 8px;
            color: var(--text-main);
            font-size: 14px;
            outline: none;
            transition: all 0.3s ease;
        }

        .user-search input:focus {
            border-color: var(--accent-cyan);
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 0 12px rgba(0, 229, 255, 0.2);
        }

        .user-search i {
            position: absolute;
            left: 14px;
            top: 14px;
            color: var(--text-muted);
            font-size: 14px;
        }

        .user-list {
            flex: 1;
            overflow-y: auto;
            padding: 0 12px 20px 12px;
        }

        .user-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .user-card:hover {
            background: rgba(124, 77, 255, 0.08);
            border-color: var(--border-hover);
            transform: translateY(-2px);
        }

        .user-card.active {
            background: rgba(124, 77, 255, 0.16);
            border-color: var(--accent-cyan);
            box-shadow: 0 0 16px rgba(124, 77, 255, 0.25);
        }

        .user-card.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--primary-glow);
        }

        .user-card-title {
            font-weight: 600;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .user-meta-badges {
            display: flex;
            gap: 6px;
            margin-top: 8px;
        }

        .badge {
            font-size: 10px;
            font-weight: 600;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .badge-rating {
            background: rgba(0, 230, 118, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(0, 230, 118, 0.25);
        }

        .badge-habit-critical {
            background: rgba(255, 23, 68, 0.15);
            color: var(--accent-red);
            border: 1px solid rgba(255, 23, 68, 0.25);
        }

        .badge-habit-balanced {
            background: rgba(124, 77, 255, 0.15);
            color: #d1c4e9;
            border: 1px solid rgba(124, 77, 255, 0.25);
        }

        .badge-country {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* MAIN CONTENT AREA */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
            background: rgba(5, 4, 10, 0.72);
        }

        /* NAVIGATION TABS */
        .nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 32px;
            border-bottom: 1px solid var(--border-color);
            background: rgba(10, 8, 20, 0.55);
            backdrop-filter: var(--glass-backdrop);
        }

        .tab-menu {
            display: flex;
            gap: 16px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 15px;
            font-weight: 600;
            padding: 8px 16px;
            cursor: pointer;
            border-radius: 6px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn:hover {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.03);
        }

        .tab-btn.active {
            color: var(--accent-cyan);
            background: rgba(0, 229, 255, 0.08);
            box-shadow: inset 0 0 8px rgba(0, 229, 255, 0.06);
            border: 1px solid rgba(0, 229, 255, 0.15);
        }

        .flavor-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 230, 118, 0.08);
            border: 1px solid rgba(0, 230, 118, 0.25);
            border-radius: 30px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 700;
            color: var(--accent-green);
        }

        /* ACTIVE SCREEN WORKSPACE */
        .workspace-panel {
            flex: 1;
            padding: 24px 32px;
            overflow-y: auto;
        }

        .tab-content {
            display: none;
            height: 100%;
            animation: fadeIn 0.4s ease forwards;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* CARD STYLE COMPONENT */
        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            backdrop-filter: var(--glass-backdrop);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.35);
            transition: all 0.3s ease;
            margin-bottom: 24px;
        }

        .glass-card:hover {
            border-color: rgba(124, 77, 255, 0.3);
            box-shadow: 0 10px 36px 0 rgba(124, 77, 255, 0.05);
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 10px;
        }

        .section-title i {
            color: var(--accent-purple);
        }

        /* GRID SYSTEM */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .grid-1-2 {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 24px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        /* PRODUCT SELECTOR */
        .product-selector {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 24px;
        }

        .product-option {
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-option:hover {
            background: rgba(124, 77, 255, 0.05);
            border-color: var(--border-hover);
        }

        .product-option.selected {
            background: rgba(0, 229, 255, 0.05);
            border-color: var(--accent-cyan);
            box-shadow: 0 0 12px rgba(0, 229, 255, 0.15);
        }

        .prod-info h4 {
            font-size: 14px;
            font-weight: 700;
        }

        .prod-info p {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .domain-tag {
            font-size: 9px;
            font-weight: 700;
            padding: 2px 6px;
            background: rgba(124, 77, 255, 0.2);
            border-radius: 4px;
            color: #d1c4e9;
            text-transform: uppercase;
        }

        /* CONTROL BAR AND TOGGLE */
        .control-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .toggle-container {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
        }

        .toggle-switch {
            width: 48px;
            height: 24px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            position: relative;
            transition: background 0.3s ease;
        }

        .toggle-switch::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 3px;
            width: 18px;
            height: 18px;
            background: #fff;
            border-radius: 50%;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .toggle-container.active .toggle-switch {
            background: var(--accent-cyan);
        }

        .toggle-container.active .toggle-switch::after {
            transform: translateX(24px);
        }

        .toggle-label {
            font-size: 13px;
            font-weight: 600;
            display: flex;
            flex-direction: column;
        }

        .toggle-desc {
            font-size: 10px;
            color: var(--text-muted);
        }

        .btn-action {
            background: var(--primary-glow);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 12px 24px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(124, 77, 255, 0.35);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-action:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(0, 229, 255, 0.5);
        }

        /* SIMULATOR OUTPUT BOX */
        .simulator-result-box {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .simulation-output {
            flex: 1;
            background: rgba(5, 4, 10, 0.45);
            border: 1px dashed var(--border-color);
            border-radius: 12px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
            min-height: 280px;
        }

        .output-empty i {
            font-size: 44px;
            color: rgba(124, 77, 255, 0.3);
            margin-bottom: 12px;
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-8px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        .output-empty p {
            color: var(--text-muted);
            font-size: 13px;
        }

        /* COMPLETED REVIEW CARDS */
        .sim-review-card {
            width: 100%;
            text-align: left;
            animation: fadeIn 0.4s ease forwards;
        }

        .sim-review-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .stars-container {
            color: #ffb300;
            font-size: 18px;
            letter-spacing: 2px;
        }

        .sim-review-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .sim-review-body {
            font-size: 13px;
            line-height: 1.6;
            color: #d1c4e9;
            background: rgba(255, 255, 255, 0.01);
            border-left: 3px solid var(--accent-cyan);
            padding: 12px 16px;
            border-radius: 0 8px 8px 0;
            margin-bottom: 16px;
        }

        .sim-indicator {
            position: absolute;
            bottom: 16px;
            right: 16px;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(0, 229, 255, 0.1);
            color: var(--accent-cyan);
            padding: 4px 10px;
            border-radius: 30px;
        }

        .history-review-card {
            background: rgba(255, 255, 255, 0.012);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 10px;
        }

        .history-review-card h5 {
            font-size: 12px;
            font-weight: 700;
            display: flex;
            justify-content: space-between;
            color: var(--text-muted);
        }

        .history-review-card p {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 6px;
            line-height: 1.4;
        }

        /* TASK B: CHAT INTERFACE */
        .chat-container {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 140px);
        }

        .chat-console {
            flex: 1;
            overflow-y: auto;
            background: rgba(5, 4, 10, 0.4);
            border: 1px solid var(--border-color);
            border-radius: 12px 12px 0 0;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .chat-msg {
            display: flex;
            flex-direction: column;
            max-width: 85%;
            animation: fadeIn 0.3s ease;
        }

        .chat-msg.user {
            align-self: flex-end;
        }

        .chat-msg.assistant {
            align-self: flex-start;
        }

        .chat-bubble {
            padding: 14px 18px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.5;
        }

        .chat-msg.user .chat-bubble {
            background: var(--accent-purple);
            color: #fff;
            border-bottom-right-radius: 2px;
            box-shadow: 0 4px 12px rgba(124, 77, 255, 0.2);
        }

        .chat-msg.assistant .chat-bubble {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            color: #d1c4e9;
            border-bottom-left-radius: 2px;
        }

        .agent-reasoning-toggle {
            font-size: 11px;
            font-weight: 700;
            color: var(--accent-cyan);
            margin-bottom: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .agent-reasoning-console {
            background: var(--terminal-bg);
            border: 1px solid rgba(0, 229, 255, 0.2);
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            color: var(--accent-cyan);
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 8px;
            white-space: pre-line;
            box-shadow: inset 0 0 10px rgba(0, 229, 255, 0.15);
        }

        .chat-input-bar {
            display: flex;
            background: rgba(10, 8, 20, 0.85);
            border: 1px solid var(--border-color);
            border-top: none;
            border-radius: 0 0 12px 12px;
            padding: 12px;
            gap: 12px;
        }

        .chat-input-bar input {
            flex: 1;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 12px 16px;
            color: var(--text-main);
            outline: none;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .chat-input-bar input:focus {
            border-color: var(--accent-cyan);
            background: rgba(255, 255, 255, 0.04);
        }

        .chat-input-bar button {
            background: var(--primary-glow);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 0 22px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .chat-input-bar button:active {
            transform: scale(0.96);
        }

        /* INTERACTIVE RECOMMENDATION CONTAINER */
        .recommender-item-container {
            background: rgba(10, 8, 20, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 16px;
            margin-top: 14px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .rec-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .rec-item-title {
            font-weight: 700;
            color: var(--text-main);
            font-size: 14px;
        }

        /* PERSONALIZATION FEEDBACK BUTTONS */
        .feedback-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .btn-feedback {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 6px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-muted);
            transition: all 0.25s ease;
        }

        .btn-feedback:hover {
            color: #fff;
            background: rgba(124, 77, 255, 0.15);
            border-color: var(--accent-purple);
        }

        .btn-feedback.active-like {
            background: rgba(0, 230, 118, 0.15);
            border-color: var(--accent-green);
            color: var(--accent-green);
            box-shadow: 0 0 10px rgba(0, 230, 118, 0.2);
        }

        .btn-feedback.active-dislike {
            background: rgba(255, 23, 68, 0.15);
            border-color: var(--accent-red);
            color: var(--accent-red);
            box-shadow: 0 0 10px rgba(255, 23, 68, 0.2);
        }

        /* RERANKING VISUAL CONSOLE */
        .rerank-console {
            margin-top: 10px;
            background: var(--terminal-bg);
            border: 1px solid rgba(124, 77, 255, 0.15);
            border-radius: 8px;
            padding: 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
        }

        .rerank-row {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 8px;
            margin-bottom: 6px;
            color: var(--text-muted);
            align-items: center;
        }

        .rerank-progress-container {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            height: 6px;
            border-radius: 3px;
            overflow: hidden;
        }

        .rerank-progress-bar {
            height: 100%;
            background: var(--primary-glow);
            border-radius: 3px;
        }

        /* GRAPH CANVAS BOX */
        .graph-box-container {
            background: rgba(5, 4, 10, 0.5);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            height: 250px;
            position: relative;
            overflow: hidden;
            margin-top: 14px;
        }

        #recommenderGraphCanvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .graph-legend {
            position: absolute;
            bottom: 8px;
            left: 8px;
            display: flex;
            gap: 12px;
            font-size: 9px;
            color: var(--text-muted);
            background: rgba(0, 0, 0, 0.6);
            padding: 4px 8px;
            border-radius: 4px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* TOAST ALERT */
        .toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast {
            background: rgba(10, 8, 20, 0.9);
            border: 1px solid var(--accent-cyan);
            border-radius: 8px;
            padding: 12px 20px;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 4px 20px rgba(0, 229, 255, 0.3);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideIn 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* DATA SCIENCE METRICS & HUMAN EVAL */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .metric-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .metric-label {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
        }

        .metric-value {
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            margin-top: 8px;
            background: linear-gradient(135deg, #fff 0%, var(--accent-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-growth {
            font-size: 10px;
            font-weight: 700;
            color: var(--accent-green);
            margin-top: 4px;
        }

        .charts-container {
            display: grid;
            grid-template-columns: 4fr 3fr;
            gap: 24px;
            margin-bottom: 24px;
        }

        .chart-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
            min-height: 320px;
        }

        .evaluation-details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .rubric-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 14px;
        }

        .rubric-item {
            font-size: 12px;
            line-height: 1.5;
            color: var(--text-muted);
            border-left: 2px solid var(--accent-purple);
            padding-left: 10px;
        }

        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.05);
            border-top: 3px solid var(--accent-cyan);
            border-radius: 50%;
            width: 32px;
            height: 32px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
    </style>
</head>

<body>

    <div class="app-container">

        <!-- SIDEBAR - USER PROFILE LIST -->
        <div class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <i class="fa-solid fa-network-wired"></i>
                    NaijaAgentX
                </div>
                <div class="sidebar-subtitle">DSN x BCT LLM Agent Platform</div>
            </div>

            <div class="user-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="user-search-input" placeholder="Search user personas..." onkeyup="filterUsers()">
            </div>

            <div class="user-list" id="user-list-container">
                <div style="display: flex; justify-content: center; padding: 40px;">
                    <div class="spinner"></div>
                </div>
            </div>
        </div>

        <!-- MAIN PANEL -->
        <div class="main-content">

            <!-- HEADER NAV MENU -->
            <div class="nav-header">
                <div class="tab-menu">
                    <button class="tab-btn active" onclick="switchTab('simulator-tab', this)">
                        <i class="fa-solid fa-user-gear"></i>
                        Task A: User Simulator
                    </button>
                    <button class="tab-btn" onclick="switchTab('recommendation-tab', this)">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        Task B: Advanced Recommender
                    </button>
                    <button class="tab-btn" onclick="switchTab('science-tab', this)">
                        <i class="fa-solid fa-flask"></i>
                        Scientific Evaluation
                    </button>
                </div>

                <div class="flavor-badge">
                    <i class="fa-solid fa-circle-check"></i>
                    Nigerian Cultural Layer Enabled
                </div>
            </div>

            <!-- WORKSPACE PANEL -->
            <div class="workspace-panel">

                <!-- TAB 1: TASK A SIMULATOR -->
                <div id="simulator-tab" class="tab-content active">
                    <div class="grid-1-2">

                        <!-- Left pane: Input triggers -->
                        <div class="glass-card"
                            style="display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <h3 class="section-title">
                                    <i class="fa-solid fa-sliders"></i>
                                    Simulation Parameters
                                </h3>

                                <div style="margin-bottom: 20px;">
                                    <h4
                                        style="font-size: 13px; font-weight: 700; color: var(--text-muted); margin-bottom: 8px;">
                                        Selected Persona:</h4>
                                    <div id="selected-user-summary"
                                        style="background: rgba(255,255,255,0.02); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                                        <p style="font-size: 13px; font-weight: 700;" id="sim-user-name">No User
                                            Selected</p>
                                        <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;"
                                            id="sim-user-stats">Select a user from the sidebar</p>
                                    </div>
                                </div>

                                <div class="product-selector">
                                    <h4
                                        style="font-size: 13px; font-weight: 700; color: var(--text-muted); margin-bottom: 4px;">
                                        Target Item to Review:</h4>

                                    <!-- Glover Court Suya -->
                                    <div class="product-option selected" data-id="food_3"
                                        onclick="selectProduct('food_3', this)">
                                        <div class="prod-info">
                                            <h4>Glover Court Suya</h4>
                                            <p>Spicy, authentic smoke-kissed Nigerian Suya seasoned with Yaji.</p>
                                        </div>
                                        <span class="domain-tag">Food</span>
                                    </div>

                                    <!-- Tribe Called Judah -->
                                    <div class="product-option" data-id="mov_1" onclick="selectProduct('mov_1', this)">
                                        <div class="prod-info">
                                            <h4>A Tribe Called Judah</h4>
                                            <p>A hilarious and gripping Nollywood drama block-buster.</p>
                                        </div>
                                        <span class="domain-tag">Movies</span>
                                    </div>

                                    <!-- Amazon Echo -->
                                    <div class="product-option" data-id="amzn_2"
                                        onclick="selectProduct('amzn_2', this)">
                                        <div class="prod-info">
                                            <h4>Amazon Echo Device</h4>
                                            <p>Smart voice assistant powered by Amazon Alexa.</p>
                                        </div>
                                        <span class="domain-tag">Electronics</span>
                                    </div>

                                    <!-- Palm wine -->
                                    <div class="product-option" data-id="drink_2"
                                        onclick="selectProduct('drink_2', this)">
                                        <div class="prod-info">
                                            <h4>Fresh Palm Wine</h4>
                                            <p>Sweet, bubbly, naturally tapped cultural drink served cold.</p>
                                        </div>
                                        <span class="domain-tag">Drinks</span>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="control-bar">
                                    <div class="toggle-container active" id="nigerian-flavor-toggle"
                                        onclick="toggleNigerianFlavor()">
                                        <div class="toggle-switch"></div>
                                        <div class="toggle-label">
                                            <span>Naija Flavor Mode</span>
                                            <span class="toggle-desc">Inject local slang & context</span>
                                        </div>
                                    </div>

                                    <button class="btn-action" onclick="runSimulation()">
                                        <i class="fa-solid fa-play"></i>
                                        Simulate Review
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Right pane: Simulation Output & Few-Shot History -->
                        <div class="grid-2">

                            <!-- Few Shot User History -->
                            <div class="glass-card" style="display: flex; flex-direction: column;">
                                <h3 class="section-title">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                    User Historical Reviews
                                </h3>
                                <div id="user-history-container" style="flex: 1; overflow-y: auto; max-height: 480px;">
                                    <p
                                        style="text-align: center; color: var(--text-muted); font-size: 13px; padding-top: 40px;">
                                        Select a user profile to view history</p>
                                </div>
                            </div>

                            <!-- Live Simulation Output Box -->
                            <div class="glass-card simulator-result-box">
                                <h3 class="section-title">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    Simulated Agent Output
                                </h3>
                                <div class="simulation-output" id="simulation-output-panel">
                                    <div class="output-empty" id="sim-empty-state">
                                        <i class="fa-solid fa-robot"></i>
                                        <p>Click "Simulate Review" to generate behavioral rating and critique copy.</p>
                                    </div>
                                    <div class="spinner" id="sim-loading-state" style="display: none;"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- TAB 2: TASK B INTELLIGENT RECOMMENDATION -->
                <div id="recommendation-tab" class="tab-content">
                    <div class="grid-1-2" style="height: 100%;">

                        <!-- Side: active profile preference analysis -->
                        <div class="glass-card"
                            style="display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <h3 class="section-title">
                                    <i class="fa-solid fa-address-card"></i>
                                    Recommender Dashboard
                                </h3>
                                <div style="display: flex; flex-direction: column; gap: 14px;">
                                    <div
                                        style="background: rgba(124, 77, 255, 0.05); padding: 14px; border-radius: 12px; border: 1px solid var(--border-color);">
                                        <h4
                                            style="font-size: 14px; font-weight: 700; color: var(--accent-cyan); display: flex; justify-content: space-between;">
                                            <span>Active User Context</span>
                                            <span id="recommender-cold-badge" class="badge badge-rating">Active</span>
                                        </h4>
                                        <p style="font-size: 13px; font-weight: 700; margin-top: 8px;"
                                            id="rec-user-name">None Selected</p>
                                        <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;"
                                            id="rec-user-desc">Select a user to analyze preferences</p>
                                    </div>

                                    <!-- Segmented tabs for Preference Radar vs FAISS Dense Search -->
                                    <div
                                        style="display: flex; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 8px; margin-top: 2px; gap: 16px;">
                                        <span id="pref-tab-radar" onclick="switchPrefSubTab('radar')"
                                            style="font-size: 12px; font-weight: 700; color: var(--accent-cyan); cursor: pointer; border-bottom: 2px solid var(--accent-cyan); padding-bottom: 4px; transition: all 0.3s;">Preference
                                            Profile</span>
                                        <span id="pref-tab-faiss" onclick="switchPrefSubTab('faiss')"
                                            style="font-size: 12px; font-weight: 700; color: var(--text-muted); cursor: pointer; padding-bottom: 4px; transition: all 0.3s;">Search
                                            Vectors</span>
                                    </div>

                                    <!-- Domain Radar Pane -->
                                    <div id="pane-radar"
                                        style="display: block; position: relative; height: 180px; width: 100%;">
                                        <canvas id="userPreferenceRadar"></canvas>
                                    </div>

                                    <!-- FAISS Dense Pane -->
                                    <div id="pane-faiss"
                                        style="display: none; position: relative; height: 180px; width: 100%;">
                                        <canvas id="faissSearchChart"></canvas>
                                    </div>
                                </div>
                            </div>

                            <!-- Interactive Recommender Graph -->
                            <div class="graph-box-container">
                                <canvas id="recommenderGraphCanvas"></canvas>
                                <div class="graph-legend">
                                    <div class="legend-item"><span
                                            style="width:8px; height:8px; border-radius:50%; background:#8c5dff; display:inline-block;"></span>
                                        User</div>
                                    <div class="legend-item"><span
                                            style="width:8px; height:8px; border-radius:50%; background:#00e5ff; display:inline-block;"></span>
                                        Twin (CF)</div>
                                    <div class="legend-item"><span
                                            style="width:8px; height:8px; border-radius:50%; background:#ffb300; display:inline-block;"></span>
                                        Item</div>
                                </div>
                            </div>

                            <!-- Dynamic In-Session Memory Block -->
                            <div id="session-memory-card"
                                style="margin-top: 14px; padding: 14px; border-radius: 12px; background: rgba(0, 229, 255, 0.02); border: 1px dashed rgba(0, 229, 255, 0.25); font-size: 12px;">
                                <h5
                                    style="font-weight: 800; color: var(--accent-cyan); font-size: 11px; text-transform: uppercase; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                                    <i class="fa-solid fa-microchip"></i>
                                    Evolving Session Memory
                                </h5>
                                <div id="session-memory-content" style="color: var(--text-muted); line-height: 1.4;">
                                    No active conversation profile. In-session preferences will be dynamically extracted
                                    in real time.
                                </div>
                            </div>
                        </div>

                        <!-- Main pane: Conversational Reasoning Engine Console -->
                        <div class="chat-container">
                            <div class="chat-console" id="chat-messages-container">
                                <div class="chat-msg assistant">
                                    <div class="chat-bubble">
                                        Hello o! I am **NaijaAgentX**, your reasoning recommendation companion. Pick a
                                        profile on the left and ask me for recommendations tailored to their taste,
                                        abeg!
                                    </div>
                                </div>
                            </div>

                            <!-- Chat Input Bar -->
                            <div class="chat-input-bar">
                                <input type="text" id="chat-user-input"
                                    placeholder="Type a message (e.g. 'Recommend a Nollywood movie or street food')..."
                                    onkeydown="if(event.key === 'Enter') sendChatMessage()">
                                <button onclick="sendChatMessage()">
                                    <i class="fa-solid fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- TAB 3: SCIENCE & ABLATION STUDIES -->
                <div id="science-tab" class="tab-content">

                    <!-- SCIENTIFIC METRIC METADATA CARDS -->
                    <div class="metrics-grid">
                        <div class="metric-card">
                            <div class="metric-label">RMSE Rating Accuracy</div>
                            <div class="metric-value" id="val-rmse">0.4472</div>
                            <div class="metric-growth"><i class="fa-solid fa-arrow-down"></i> -80.7% error vs Baseline
                            </div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-label">ROUGE-L Linguistic Score</div>
                            <div class="metric-value" id="val-rouge">0.0756</div>
                            <div class="metric-growth"><i class="fa-solid fa-arrow-up"></i> +11.5% vs Baseline</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-label">Hit Rate @ 10 (Ranking Quality)</div>
                            <div class="metric-value" id="val-hr">100.0%</div>
                            <div class="metric-growth"><i class="fa-solid fa-arrow-up"></i> Dynamic Domain Boost</div>
                        </div>
                        <div class="metric-card">
                            <div class="metric-label">NDCG @ 10 (Relevance Gain)</div>
                            <div class="metric-value" id="val-ndcg">0.6621</div>
                            <div class="metric-growth"><i class="fa-solid fa-arrow-up"></i> Semantic Search Active</div>
                        </div>
                    </div>

                    <!-- DATA SCIENCE CHARTS -->
                    <div class="charts-container">
                        <!-- Ablation Bar Chart -->
                        <div class="chart-box">
                            <h3 class="section-title">
                                <i class="fa-solid fa-chart-simple"></i>
                                Empirical Model Performance (Ablation Study)
                            </h3>
                            <div style="position: relative; height: 260px; width: 100%;">
                                <canvas id="ablationChart"></canvas>
                            </div>
                        </div>

                        <!-- Cohen's Kappa Consensus & Rubrics -->
                        <div class="glass-card" style="margin-bottom:0;">
                            <h3 class="section-title">
                                <i class="fa-solid fa-users-viewfinder"></i>
                                Human Study consensus (Inter-Rater agreement)
                            </h3>
                            <div style="display:flex; align-items:center; gap:20px; margin-bottom: 14px;">
                                <div style="position: relative; width: 110px; height: 110px; flex-shrink:0;">
                                    <canvas id="kappaGaugeChart"></canvas>
                                </div>
                                <div>
                                    <h4 style="font-size: 15px; font-weight:700; color:var(--accent-cyan);"
                                        id="kappa-text">Cohen's Kappa (k): 0.84</h4>
                                    <p
                                        style="font-size:12px; color:var(--text-muted); line-height:1.4; margin-top:4px;">
                                        Indicates <strong>Near-Perfect Agreement</strong> among our 10 native
                                        annotators. The consensus confirms the reliability of ratings for cultural tone,
                                        slangs, and local infrastructural accuracy.
                                    </p>
                                </div>
                            </div>
                            <div>
                                <h4
                                    style="font-size: 12px; font-weight:700; color:var(--text-main); border-top: 1px solid rgba(255,255,255,0.05); padding-top:10px;">
                                    Annotator Scoring Rubric (1-5 Likert scale)</h4>
                                <ul class="rubric-list">
                                    <li class="rubric-item"><strong>Linguistic Authenticity:</strong> Correct Pidgin
                                        slang weight, natural flow, no robotic translation artifacts.</li>
                                    <li class="rubric-item"><strong>Conversational Empathy:</strong> Empathy regarding
                                        local conditions (power outages, grid noise, billing, traffic).</li>
                                    <li class="rubric-item"><strong>Contextual Relevancy:</strong> Recommendations match
                                        immediate stated customer constraints.</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Human Study 4-Pillar Chart -->
                    <div class="glass-card">
                        <h3 class="section-title">
                            <i class="fa-solid fa-people-arrows"></i>
                            Human Evaluation: 4-Pillar Blind Likert Study (10 Native Annotators)
                        </h3>
                        <div class="evaluation-details-grid">
                            <div style="position: relative; height: 260px; width: 100%;">
                                <canvas id="humanStudyChart"></canvas>
                            </div>
                            <div
                                style="font-size: 13px; line-height: 1.6; color: var(--text-muted); display: flex; flex-direction: column; justify-content: center; gap: 14px;">
                                <p>
                                    Our double-blind study sampled <strong>10 native speakers</strong> (Lagos, Abuja,
                                    Port Harcourt) to evaluate <strong>50 simulated outputs</strong> across both
                                    configurations.
                                </p>
                                <p>
                                    <strong style="color: var(--accent-cyan);"><i class="fa-solid fa-circle-nodes"></i>
                                        Linguistic Authenticity:</strong>
                                    NaijaAgentX scores <strong>4.80 ± 0.42</strong> compared to the baseline's 2.10.
                                    Simple persona conditioning fails to sound organic, whereas our localized layer
                                    captures native cadences perfectly.
                                </p>
                                <p>
                                    <strong style="color: var(--accent-green);"><i class="fa-solid fa-face-smile"></i>
                                        Conversational Empathy:</strong>
                                    NaijaAgentX scores <strong>4.90 ± 0.31</strong>. Acknowledging local situations
                                    (like blaming Okada riders or NEPA taking light) yields a significantly more
                                    empathetic, engaging experience.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Toast alert notification container -->
    <div class="toast-container" id="toast-container"></div>

    <!-- MAIN FRONTEND CLIENT SCRIPT -->
    <script>
        let users = [];
        let selectedUser = null;
        let selectedProduct = "food_3"; // Default Glover Court Suya
        let nigerianFlavor = true;
        let chatHistory = [];
        let ablationData = {};
        let humanEvalData = {};
        let ablationChart = null;
        let humanStudyChart = null;
        let kappaGaugeChart = null;

        // Initialize App
        window.addEventListener('DOMContentLoaded', () => {
            fetchUsers();
            fetchAblationData();
            fetchHumanEvalData();
            initGraphCanvas();
        });

        // Show Toast Notification
        function showToast(message, icon = "fa-circle-info") {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `
                <i class="fa-solid ${icon}"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Fetch User Roster from FastAPI
        function fetchUsers() {
            fetch('/api/users')
                .then(res => res.json())
                .then(data => {
                    users = data;
                    renderUserList(users);
                    if (users.length > 0) {
                        selectUser(users[0].user_id);
                    }
                })
                .catch(err => console.error("Error fetching users:", err));
        }

        // Fetch Ablation statistics
        function fetchAblationData() {
            fetch('/api/ablation')
                .then(res => res.json())
                .then(data => {
                    ablationData = data;
                    renderAblationChart(data);
                    renderMetricCards(data);
                })
                .catch(err => console.error("Error fetching ablation studies:", err));
        }

        // Fetch Human Evaluation statistics
        function fetchHumanEvalData() {
            fetch('/api/human_eval')
                .then(res => res.json())
                .then(data => {
                    if (data.status === "missing") return;
                    humanEvalData = data;
                    renderHumanStudyChart(data);
                    renderKappaGauge(data.kappa_agreement.overall_kappa);
                    document.getElementById('kappa-text').innerText = `Cohen's Kappa (k): ${data.kappa_agreement.overall_kappa.toFixed(2)}`;
                })
                .catch(err => console.error("Error fetching human studies:", err));
        }

        // Render Sidebar List
        function renderUserList(userRoster) {
            const container = document.getElementById('user-list-container');
            container.innerHTML = '';

            userRoster.forEach(u => {
                const card = document.createElement('div');
                card.className = `user-card ${selectedUser && selectedUser.user_id === u.user_id ? 'active' : ''}`;
                card.id = `user-card-${u.user_id}`;
                card.onclick = () => selectUser(u.user_id);

                const habitClass = u.rating_habit === 'critical' ? 'badge-habit-critical' : 'badge-habit-balanced';

                card.innerHTML = `
                    <div class="user-card-title">
                        <span>${u.name}</span>
                        <span style="font-size: 11px; color: var(--accent-cyan); font-weight: 700;">${u.reviews_count} rev</span>
                    </div>
                    <div class="user-meta-badges">
                        <span class="badge badge-rating"><i class="fa-solid fa-star"></i> ${u.avg_rating}</span>
                        <span class="badge ${habitClass}">${u.rating_habit}</span>
                        <span class="badge badge-country">${u.country || 'NG'}</span>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Search Filter
        function filterUsers() {
            const query = document.getElementById('user-search-input').value.toLowerCase();
            const filtered = users.filter(u => u.name.toLowerCase().includes(query) || u.user_id.toLowerCase().includes(query));
            renderUserList(filtered);
        }

        // Select a user profile
        function selectUser(userId) {
            document.querySelectorAll('.user-card').forEach(c => c.classList.remove('active'));

            selectedUser = users.find(u => u.user_id === userId);
            if (!selectedUser) return;

            const activeCard = document.getElementById(`user-card-${userId}`);
            if (activeCard) activeCard.classList.add('active');

            // Update Task A placeholders
            document.getElementById('sim-user-name').innerText = selectedUser.name;
            document.getElementById('sim-user-stats').innerText = `Origin: ${selectedUser.country || 'Unknown'} | Rating Habit: ${selectedUser.rating_habit} (${selectedUser.avg_rating} avg)`;

            // Update Task B placeholders
            document.getElementById('rec-user-name').innerText = selectedUser.name;
            document.getElementById('rec-user-desc').innerText = `${selectedUser.rating_habit.toUpperCase()} persona | Country: ${selectedUser.country}`;
            document.getElementById('recommender-cold-badge').innerText = selectedUser.reviews_count === 0 ? "Cold-Start" : "Active";
            document.getElementById('recommender-cold-badge').className = `badge ${selectedUser.reviews_count === 0 ? 'badge-habit-critical' : 'badge-rating'}`;

            // Render History Few-Shots
            renderUserHistory(selectedUser.history);

            // Compute and display preferences
            renderPreferences(selectedUser);

            // Render initial recommender graph
            updateRecommenderGraph(selectedUser, []);
        }

        // Render past reviews side-by-side
        function renderUserHistory(history) {
            const container = document.getElementById('user-history-container');
            if (!history || history.length === 0) {
                container.innerHTML = `<p style="text-align: center; color: var(--text-muted); font-size: 13px; padding-top: 40px;">No historical purchases found. Operating in Cold-Start mode o.</p>`;
                return;
            }

            container.innerHTML = '';
            history.slice(0, 4).forEach(rev => {
                const stars = '★'.repeat(rev.rating) + '☆'.repeat(5 - rev.rating);
                const item = document.createElement('div');
                item.className = 'history-review-card';
                item.innerHTML = `
                    <h5>
                        <span>${rev.product_title}</span>
                        <span style="color: #ffb300;">${stars}</span>
                    </h5>
                    <p style="font-weight: 700; font-size: 11px; margin-top: 4px; color: var(--text-main);">${rev.title}</p>
                    <p>"${rev.text}"</p>
                `;
                container.appendChild(item);
            });
        }

        let preferenceRadarChart = null;
        let faissRetrievedChart = null;

        // Switch active segmented pref pane
        function switchPrefSubTab(subTab) {
            const radarTab = document.getElementById('pref-tab-radar');
            const faissTab = document.getElementById('pref-tab-faiss');
            const radarPane = document.getElementById('pane-radar');
            const faissPane = document.getElementById('pane-faiss');

            if (subTab === 'radar') {
                radarTab.style.color = 'var(--accent-cyan)';
                radarTab.style.borderBottom = '2px solid var(--accent-cyan)';
                faissTab.style.color = 'var(--text-muted)';
                faissTab.style.borderBottom = 'none';
                radarPane.style.display = 'block';
                faissPane.style.display = 'none';
                if (preferenceRadarChart) preferenceRadarChart.update();
            } else {
                faissTab.style.color = 'var(--accent-cyan)';
                faissTab.style.borderBottom = '2px solid var(--accent-cyan)';
                radarTab.style.color = 'var(--text-muted)';
                radarTab.style.borderBottom = 'none';
                radarPane.style.display = 'none';
                faissPane.style.display = 'block';
                if (faissRetrievedChart) faissRetrievedChart.update();
            }
        }

        // Render Preference Radar in Task B
        function renderPreferences(user) {
            const isCold = user.reviews_count === 0;
            let movies = 50, food = 50, drinks = 50, books = 50, electronics = 50;

            if (!isCold && user.history) {
                user.history.forEach(rev => {
                    const dom = rev.domain ? rev.domain.toLowerCase() : "electronics";
                    const points = rev.rating * 15;
                    if (dom.includes("movie")) movies = Math.min(100, movies + points - 15);
                    else if (dom.includes("food")) food = Math.min(100, food + points - 15);
                    else if (dom.includes("drink")) drinks = Math.min(100, drinks + points - 15);
                    else if (dom.includes("book")) books = Math.min(100, books + points - 15);
                    else electronics = Math.min(100, electronics + points - 15);
                });
            } else if (isCold && user.country === "NG") {
                movies = 85; food = 90; drinks = 80; books = 65; electronics = 40;
            }

            const data = [movies, food, drinks, books, electronics];

            if (preferenceRadarChart) {
                preferenceRadarChart.data.datasets[0].data = data;
                preferenceRadarChart.update();
                return;
            }

            const ctx = document.getElementById('userPreferenceRadar').getContext('2d');
            preferenceRadarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['Movies', 'Food', 'Drinks', 'Books', 'Electronics'],
                    datasets: [{
                        label: 'Domain Affinity',
                        data: data,
                        backgroundColor: 'rgba(124, 77, 255, 0.15)',
                        borderColor: 'rgba(124, 77, 255, 0.85)',
                        pointBackgroundColor: '#00e5ff',
                        pointBorderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            angleLines: { color: 'rgba(255, 255, 255, 0.08)' },
                            grid: { color: 'rgba(255, 255, 255, 0.08)' },
                            pointLabels: { color: '#9e95c7', font: { family: 'Outfit', size: 10 } },
                            ticks: { display: false },
                            min: 0,
                            max: 100
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // Draw FAISS Retrieval Scores Horizontal Bar Chart
        function updateFAISSSearchChart(recommendedItems) {
            const labels = [];
            const scores = [];

            recommendedItems.forEach(item => {
                labels.push(item.title);
                scores.push(item.similarity_score || item.search_score || 0.65);
            });

            if (faissRetrievedChart) {
                faissRetrievedChart.data.labels = labels;
                faissRetrievedChart.data.datasets[0].data = scores;
                faissRetrievedChart.update();
                return;
            }

            const ctx = document.getElementById('faissSearchChart').getContext('2d');
            faissRetrievedChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Dense Match (FAISS)',
                        data: scores,
                        backgroundColor: 'rgba(0, 229, 255, 0.45)',
                        borderColor: '#00e5ff',
                        borderWidth: 1.5,
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            beginAtZero: true,
                            min: 0,
                            max: 1,
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#9e95c7', size: 9 }
                        },
                        y: {
                            grid: { display: false },
                            ticks: {
                                color: '#f3f0ff',
                                font: { family: 'Outfit', size: 8 }
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // Select Product for Task A Simulation
        function selectProduct(prodId, element) {
            document.querySelectorAll('.product-option').forEach(opt => opt.classList.remove('selected'));
            element.classList.add('selected');
            selectedProduct = prodId;
        }

        // Toggle Nigerian mode trigger
        function toggleNigerianFlavor() {
            const toggle = document.getElementById('nigerian-flavor-toggle');
            nigerianFlavor = !nigerianFlavor;
            if (nigerianFlavor) {
                toggle.classList.add('active');
            } else {
                toggle.classList.remove('active');
            }
        }

        // Run Task A Simulation
        function runSimulation() {
            if (!selectedUser) {
                alert("Abeg select a user from the sidebar first!");
                return;
            }

            const outputPanel = document.getElementById('simulation-output-panel');
            const emptyState = document.getElementById('sim-empty-state');
            const loadingState = document.getElementById('sim-loading-state');

            emptyState.style.display = 'none';
            loadingState.style.display = 'block';

            const oldCard = document.getElementById('active-sim-review-result');
            if (oldCard) oldCard.remove();

            fetch('/api/simulate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_id: selectedUser.user_id,
                    product_id: selectedProduct,
                    use_nigerian_flavor: nigerianFlavor
                })
            })
                .then(res => res.json())
                .then(data => {
                    loadingState.style.display = 'none';

                    const stars = '★'.repeat(data.rating) + '☆'.repeat(5 - data.rating);

                    const card = document.createElement('div');
                    card.className = 'sim-review-card';
                    card.id = 'active-sim-review-result';

                    const llmTag = data.is_simulated_by_llm
                        ? `<span class="sim-indicator"><i class="fa-solid fa-robot"></i> LLM Simulated</span>`
                        : `<span class="sim-indicator" style="background: rgba(124,77,255,0.1); color: var(--accent-purple);"><i class="fa-solid fa-microchip"></i> Rule-Engine</span>`;

                    card.innerHTML = `
                    <div class="sim-review-header">
                        <span class="stars-container">${stars}</span>
                        <span style="font-size: 11px; font-weight: 700; color: var(--text-muted);">${new Date().toISOString().split('T')[0]}</span>
                    </div>
                    <h4 class="sim-review-title">${data.title}</h4>
                    <div class="sim-review-body">
                        "${data.text}"
                    </div>
                    ${llmTag}
                `;
                    outputPanel.appendChild(card);
                })
                .catch(err => {
                    console.error(err);
                    loadingState.style.display = 'none';
                    emptyState.style.display = 'flex';
                    alert("Wahala dey! Simulation failed.");
                });
        }

        // TAB SWITCHER
        function switchTab(tabId, element) {
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));

            document.getElementById(tabId).classList.add('active');
            element.classList.add('active');

            if (tabId === 'science-tab' && ablationChart) {
                setTimeout(() => {
                    ablationChart.update();
                    if (humanStudyChart) humanStudyChart.update();
                    if (kappaGaugeChart) kappaGaugeChart.update();
                }, 150);
            }
        }

        // Personalization Loop Action
        function sendPersonalizationAction(productId, action, buttonEl) {
            if (!selectedUser) return;

            const userId = selectedUser.user_id;

            // Toggle classes visually
            const pCard = buttonEl.closest('.recommender-item-container');
            const likeBtn = pCard.querySelector('.like-btn');
            const dislikeBtn = pCard.querySelector('.dislike-btn');

            if (action === 'like') {
                if (likeBtn.classList.contains('active-like')) {
                    return; // Already liked
                }
                likeBtn.classList.add('active-like');
                dislikeBtn.classList.remove('active-dislike');
                showToast("Dynamic Learning: Positive preference locked in!", "fa-circle-check");
            } else {
                if (dislikeBtn.classList.contains('active-dislike')) {
                    return; // Already disliked
                }
                dislikeBtn.classList.add('active-dislike');
                likeBtn.classList.remove('active-like');
                showToast("Dynamic Learning: Reranking weights adjusted!", "fa-triangle-exclamation");
            }

            fetch('/api/personalize', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_id: userId,
                    product_id: productId,
                    action: action
                })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === "success") {
                        updateEvolvingSessionMemory(data.user_memory);
                    }
                })
                .catch(err => console.error("Personalization loop error:", err));
        }

        // Helper to render session memory details
        function updateEvolvingSessionMemory(mem) {
            const memoryContainer = document.getElementById('session-memory-content');

            let likesHtml = mem.liked_categories.length > 0
                ? mem.liked_categories.map(c => `<span style="display:inline-block; padding:2px 6px; background:rgba(0,230,118,0.1); border:1px solid rgba(0,230,118,0.25); border-radius:4px; margin-right:4px; font-weight:700; color:#00e676; font-size:10px; text-transform:uppercase;">${c}</span>`).join('')
                : '<span style="color:var(--text-muted); font-style:italic;">None</span>';

            let dislikesHtml = mem.disliked_traits.length > 0
                ? mem.disliked_traits.map(t => `<span style="display:inline-block; padding:2px 6px; background:rgba(255,23,68,0.1); border:1px solid rgba(255,23,68,0.25); border-radius:4px; margin-right:4px; font-weight:700; color:#ff1744; font-size:10px; text-transform:uppercase;">${t}</span>`).join('')
                : '<span style="color:var(--text-muted); font-style:italic;">None</span>';

            let budgetHtml = `<span style="display:inline-block; padding:2px 6px; background:rgba(0,229,255,0.1); border:1px solid rgba(0,229,255,0.25); border-radius:4px; font-weight:700; color:#00e5ff; font-size:10px; text-transform:uppercase;">${mem.budget}</span>`;

            memoryContainer.innerHTML = `
                <div style="margin-bottom: 6px;"><strong>Likes:</strong> ${likesHtml}</div>
                <div style="margin-bottom: 6px;"><strong>Dislikes:</strong> ${dislikesHtml}</div>
                <div><strong>Budget Preference:</strong> ${budgetHtml}</div>
            `;
        }

        // Send Conversational recommendation query
        function sendChatMessage() {
            const input = document.getElementById('chat-user-input');
            const query = input.value.trim();
            if (!query) return;

            if (!selectedUser) {
                alert("Select a user from the sidebar to represent conversation context!");
                return;
            }

            const messagesContainer = document.getElementById('chat-messages-container');

            // Append User message
            const userMsgDiv = document.createElement('div');
            userMsgDiv.className = 'chat-msg user';
            userMsgDiv.innerHTML = `<div class="chat-bubble">${query}</div>`;
            messagesContainer.appendChild(userMsgDiv);

            // Append loading indicator
            const loadMsgDiv = document.createElement('div');
            loadMsgDiv.className = 'chat-msg assistant';
            loadMsgDiv.id = 'chat-loading-indicator';
            loadMsgDiv.innerHTML = `<div class="chat-bubble" style="display: flex; gap: 8px; align-items: center;"><div class="spinner" style="width: 14px; height: 14px; border-width: 2px;"></div> Reasoning...</div>`;
            messagesContainer.appendChild(loadMsgDiv);

            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            input.value = '';

            // Call recommendation API
            fetch('/api/recommend', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_id: selectedUser.user_id,
                    message: query,
                    chat_history: chatHistory
                })
            })
                .then(res => res.json())
                .then(data => {
                    document.getElementById('chat-loading-indicator').remove();

                    const assistantMsgDiv = document.createElement('div');
                    assistantMsgDiv.className = 'chat-msg assistant';

                    const randId = Math.floor(Math.random() * 100000);
                    const formattedReasoning = data.reasoning.replace(/\n/g, '<br>');

                    // Construct recommended items container with active personalization actions
                    let itemsHtml = '';
                    if (data.recommended_items && data.recommended_items.length > 0) {
                        itemsHtml = `<div class="recommender-item-container">
                        <div style="font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; border-bottom:1px solid rgba(255,255,255,0.05); padding-bottom:4px; display:flex; justify-content:space-between;">
                            <span>Recommender Reranking Score Details</span>
                            <span style="color:var(--accent-purple)"><i class="fa-solid fa-ranking-star"></i> Multi-Stage Blending</span>
                        </div>`;

                        data.recommended_items.forEach(item => {
                            const sim = item.similarity_score || 0.65;
                            const cf = item.cf_score || 0.0;
                            const gr = item.graph_score || 0.0;
                            const ce = item.cross_encoder_score || 0.0;
                            const final = item.search_score || 0.88;

                            itemsHtml += `
                            <div style="margin-top: 8px; padding-bottom:8px; border-bottom: 1px solid rgba(255,255,255,0.03);">
                                <div class="rec-item-header">
                                    <span class="rec-item-title">${item.title}</span>
                                    <div class="feedback-actions">
                                        <button class="btn-feedback like-btn" onclick="sendPersonalizationAction('${item.id}', 'like', this)" title="Upvote product to learn preference">
                                            <i class="fa-solid fa-thumbs-up"></i>
                                        </button>
                                        <button class="btn-feedback dislike-btn" onclick="sendPersonalizationAction('${item.id}', 'dislike', this)" title="Downvote product to blacklist traits">
                                            <i class="fa-solid fa-thumbs-down"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="rerank-console">
                                    <div class="rerank-row">
                                        <span>FAISS Dense Similarity Match</span>
                                        <span style="text-align:right; font-weight:700;">${sim.toFixed(4)}</span>
                                    </div>
                                    <div class="rerank-progress-container" style="margin-bottom:8px;"><div class="rerank-progress-bar" style="width:${sim * 100}%;"></div></div>
                                    
                                    <div class="rerank-row">
                                        <span>User Collaborative Filtering</span>
                                        <span style="text-align:right; font-weight:700; color:var(--accent-cyan);">${cf.toFixed(4)}</span>
                                    </div>
                                    <div class="rerank-progress-container" style="margin-bottom:8px;"><div class="rerank-progress-bar" style="width:${cf * 100}%; background:var(--accent-cyan);"></div></div>

                                    <div class="rerank-row">
                                        <span>Graph Co-occurrence Network</span>
                                        <span style="text-align:right; font-weight:700; color:var(--accent-green);">${gr.toFixed(4)}</span>
                                    </div>
                                    <div class="rerank-progress-container" style="margin-bottom:8px;"><div class="rerank-progress-bar" style="width:${gr * 100}%; background:var(--accent-green);"></div></div>

                                    <div class="rerank-row">
                                        <span>Cross-Encoder Lexical Overlap</span>
                                        <span style="text-align:right; font-weight:700; color:var(--accent-purple);">${ce.toFixed(4)}</span>
                                    </div>
                                    <div class="rerank-progress-container" style="margin-bottom:8px;"><div class="rerank-progress-bar" style="width:${Math.min(100, ce * 100)}%; background:var(--accent-purple);"></div></div>
                                    
                                    <div class="rerank-row" style="margin-top:6px; font-weight:700; color:#fff;">
                                        <span>Final Blended Score</span>
                                        <span style="text-align:right; color:#ffb300;">${final.toFixed(4)}</span>
                                    </div>
                                </div>
                            </div>
                        `;
                        });
                        itemsHtml += '</div>';
                    }

                    assistantMsgDiv.innerHTML = `
                    <div class="agent-reasoning-toggle" onclick="toggleReasoningBlock(${randId})">
                        <i class="fa-solid fa-terminal"></i>
                        Agent Reasoning Chain (CoT)
                        <i class="fa-solid fa-chevron-down" id="reason-icon-${randId}"></i>
                    </div>
                    <div class="agent-reasoning-console" id="reason-block-${randId}" style="display: none;">
                        ${formattedReasoning}
                    </div>
                    <div class="chat-bubble">
                        ${data.response.replace(/\n/g, '<br>')}
                    </div>
                    ${itemsHtml}
                `;
                    messagesContainer.appendChild(assistantMsgDiv);
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;

                    // Update session memory
                    if (data.user_memory) {
                        updateEvolvingSessionMemory(data.user_memory);
                        if (data.recommended_items) {
                            updateFAISSSearchChart(data.recommended_items);
                            switchPrefSubTab('faiss');
                            updateRecommenderGraph(selectedUser, data.recommended_items);
                        }
                    }

                    chatHistory.push({ role: "user", content: query });
                    chatHistory.push({ role: "assistant", content: data.response });
                })
                .catch(err => {
                    console.error(err);
                    const loadInd = document.getElementById('chat-loading-indicator');
                    if (loadInd) loadInd.remove();
                    alert("Recommendation agent failed to resolve abeg.");
                });
        }

        function toggleReasoningBlock(randId) {
            const block = document.getElementById(`reason-block-${randId}`);
            const icon = document.getElementById(`reason-icon-${randId}`);
            if (block.style.display === 'none') {
                block.style.display = 'block';
                icon.className = 'fa-solid fa-chevron-up';
            } else {
                block.style.display = 'none';
                icon.className = 'fa-solid fa-chevron-down';
            }
        }

        // Render science validation metrics onto top cards
        function renderMetricCards(data) {
            if (!data.naija_agent) return;
            const naija = data.naija_agent;

            document.getElementById('val-rmse').innerText = naija.RMSE.toFixed(4);
            document.getElementById('val-rouge').innerText = naija.ROUGE_L.toFixed(4);
            document.getElementById('val-hr').innerText = (naija.HR_10 * 100).toFixed(1) + "%";
            document.getElementById('val-ndcg').innerText = naija.NDCG_10.toFixed(4);
        }

        // Load ablation metrics onto Chart.js
        function renderAblationChart(metrics) {
            const ctx = document.getElementById('ablationChart').getContext('2d');

            const configs = ['Baseline', 'Persona Conditioned', 'NaijaAgentX'];
            const rmseVals = [metrics.baseline.RMSE, metrics.persona_conditioned.RMSE, metrics.naija_agent.RMSE];
            const rougeVals = [metrics.baseline.ROUGE_L, metrics.persona_conditioned.ROUGE_L, metrics.naija_agent.ROUGE_L];
            const hrVals = [metrics.baseline.HR_10, metrics.persona_conditioned.HR_10, metrics.naija_agent.HR_10];
            const ndcgVals = [metrics.baseline.NDCG_10, metrics.persona_conditioned.NDCG_10, metrics.naija_agent.NDCG_10];

            if (ablationChart) {
                ablationChart.destroy();
            }

            ablationChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: configs,
                    datasets: [
                        {
                            label: 'Rating RMSE (Lower is Better)',
                            data: rmseVals,
                            backgroundColor: 'rgba(255, 23, 68, 0.65)',
                            borderColor: '#ff1744',
                            borderWidth: 1.5,
                            borderRadius: 6
                        },
                        {
                            label: 'Linguistic ROUGE-L',
                            data: rougeVals,
                            backgroundColor: 'rgba(124, 77, 255, 0.65)',
                            borderColor: '#7c4dff',
                            borderWidth: 1.5,
                            borderRadius: 6
                        },
                        {
                            label: 'Hit Rate@10',
                            data: hrVals,
                            backgroundColor: 'rgba(0, 230, 118, 0.65)',
                            borderColor: '#00e676',
                            borderWidth: 1.5,
                            borderRadius: 6
                        },
                        {
                            label: 'NDCG@10',
                            data: ndcgVals,
                            backgroundColor: 'rgba(0, 229, 255, 0.65)',
                            borderColor: '#00e5ff',
                            borderWidth: 1.5,
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#9e95c7' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9e95c7' }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: {
                                color: '#f3f0ff',
                                font: { family: 'Outfit', size: 10 }
                            }
                        }
                    }
                }
            });
        }

        // Render 4-Pillar Human Evaluation Likert Chart
        function renderHumanStudyChart(data) {
            const ctx = document.getElementById('humanStudyChart').getContext('2d');

            const pillars = [
                'Linguistic Authenticity',
                'Contextual Relevancy',
                'Personalization Depth',
                'Conversational Empathy'
            ];

            const p = data.pillars;
            const personaVals = [
                p.linguistic_authenticity.persona_conditioned.mean,
                p.contextual_relevancy.persona_conditioned.mean,
                p.personalization_depth.persona_conditioned.mean,
                p.conversational_empathy.persona_conditioned.mean
            ];
            const naijaVals = [
                p.linguistic_authenticity.naija_agent.mean,
                p.contextual_relevancy.naija_agent.mean,
                p.personalization_depth.naija_agent.mean,
                p.conversational_empathy.naija_agent.mean
            ];

            if (humanStudyChart) {
                humanStudyChart.destroy();
            }

            humanStudyChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: pillars,
                    datasets: [
                        {
                            label: 'Persona Conditioned Only',
                            data: personaVals,
                            backgroundColor: 'rgba(124, 77, 255, 0.4)',
                            borderColor: 'rgba(124, 77, 255, 0.8)',
                            borderWidth: 1.5,
                            borderRadius: 4
                        },
                        {
                            label: 'NaijaAgentX (Full Framework)',
                            data: naijaVals,
                            backgroundColor: 'rgba(0, 229, 255, 0.55)',
                            borderColor: '#00e5ff',
                            borderWidth: 1.5,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 5,
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#9e95c7', stepSize: 1 }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9e95c7', font: { size: 9 } }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: {
                                color: '#f3f0ff',
                                font: { family: 'Outfit', size: 9 }
                            }
                        }
                    }
                }
            });
        }

        // Render Cohen's Kappa Gauge Chart
        function renderKappaGauge(kappa) {
            const ctx = document.getElementById('kappaGaugeChart').getContext('2d');

            if (kappaGaugeChart) {
                kappaGaugeChart.destroy();
            }

            kappaGaugeChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [kappa, 1 - kappa],
                        backgroundColor: [
                            'rgba(0, 229, 255, 0.85)',
                            'rgba(255, 255, 255, 0.05)'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '80%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    }
                }
            });
        }

        /* 
        -------------------------------------------------------------
        2D INTERACTIVE RECOMMENDER GRAPH IMPLEMENTATION (CANVAS)
        -------------------------------------------------------------
        */
        let graphNodes = [];
        let graphLinks = [];
        let animationFrameId = null;
        let canvas, gCtx;

        function initGraphCanvas() {
            canvas = document.getElementById('recommenderGraphCanvas');
            if (!canvas) return;
            gCtx = canvas.getContext('2d');

            // Set canvas resolution
            const resize = () => {
                canvas.width = canvas.parentElement.clientWidth;
                canvas.height = canvas.parentElement.clientHeight || 250;
            };
            resize();
            window.addEventListener('resize', resize);

            // Start basic animation loop
            if (animationFrameId) cancelAnimationFrame(animationFrameId);
            animateGraph();
        }

        function updateRecommenderGraph(user, recommendedItems) {
            if (!canvas) return;
            const w = canvas.width;
            const h = canvas.height;

            graphNodes = [];
            graphLinks = [];

            // 1. Central User Node
            const centerNode = {
                id: 'user',
                label: user.name.split(' ')[0],
                type: 'user',
                x: w / 2,
                y: h / 2,
                targetX: w / 2,
                targetY: h / 2,
                radius: 20,
                color: '#8c5dff'
            };
            graphNodes.push(centerNode);

            // 2. Add Demographic Twins (CF Neighbors)
            const twins = [
                { name: 'Ngozi', sim: 0.94 },
                { name: 'Chidi', sim: 0.89 }
            ];

            twins.forEach((twin, idx) => {
                const angle = (idx * Math.PI) - (Math.PI / 4);
                const dist = 75;
                const twinNode = {
                    id: `twin_${idx}`,
                    label: `${twin.name} (${twin.sim})`,
                    type: 'twin',
                    x: (w / 2) + Math.cos(angle) * dist + (Math.random() - 0.5) * 10,
                    y: (h / 2) + Math.sin(angle) * dist + (Math.random() - 0.5) * 10,
                    targetX: (w / 2) + Math.cos(angle) * dist,
                    targetY: (h / 2) + Math.sin(angle) * dist,
                    radius: 12,
                    color: '#00e5ff'
                };
                graphNodes.push(twinNode);
                graphLinks.push({ source: centerNode, target: twinNode, type: 'cf' });
            });

            // 3. Recommended Items Nodes
            if (recommendedItems && recommendedItems.length > 0) {
                recommendedItems.forEach((item, idx) => {
                    const angle = (idx * (2 * Math.PI / recommendedItems.length)) + Math.PI / 2;
                    const dist = 90;
                    const itemNode = {
                        id: `item_${item.id}`,
                        label: item.title.split(' ')[0],
                        type: 'item',
                        x: (w / 2) + Math.cos(angle) * dist + (Math.random() - 0.5) * 15,
                        y: (h / 2) + Math.sin(angle) * dist + (Math.random() - 0.5) * 15,
                        targetX: (w / 2) + Math.cos(angle) * dist,
                        targetY: (h / 2) + Math.sin(angle) * dist,
                        radius: 15,
                        color: '#ffb300'
                    };
                    graphNodes.push(itemNode);
                    graphLinks.push({ source: centerNode, target: itemNode, type: 'rec' });
                });
            } else {
                // Initial catalog domain seeds
                const domains = ['Food', 'Movies', 'Drinks', 'Books'];
                domains.forEach((dom, idx) => {
                    const angle = (idx * (2 * Math.PI / domains.length));
                    const dist = 85;
                    const domNode = {
                        id: `dom_${idx}`,
                        label: dom,
                        type: 'dom',
                        x: (w / 2) + Math.cos(angle) * dist,
                        y: (h / 2) + Math.sin(angle) * dist,
                        targetX: (w / 2) + Math.cos(angle) * dist,
                        targetY: (h / 2) + Math.sin(angle) * dist,
                        radius: 11,
                        color: 'rgba(124, 77, 255, 0.45)'
                    };
                    graphNodes.push(domNode);
                    graphLinks.push({ source: centerNode, target: domNode, type: 'seed' });
                });
            }
        }

        function animateGraph() {
            if (!canvas || !gCtx) return;

            // Clear canvas
            gCtx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw link edges
            graphLinks.forEach(link => {
                gCtx.beginPath();
                gCtx.moveTo(link.source.x, link.source.y);
                gCtx.lineTo(link.target.x, link.target.y);

                if (link.type === 'cf') {
                    gCtx.strokeStyle = 'rgba(0, 229, 255, 0.25)';
                    gCtx.setLineDash([4, 4]);
                } else if (link.type === 'rec') {
                    gCtx.strokeStyle = 'rgba(255, 179, 0, 0.45)';
                    gCtx.setLineDash([]);
                } else {
                    gCtx.strokeStyle = 'rgba(124, 77, 255, 0.25)';
                    gCtx.setLineDash([]);
                }

                gCtx.lineWidth = 1.5;
                gCtx.stroke();
                gCtx.setLineDash([]); // Reset line dash
            });

            // Update node physics (gentle spring pull towards target positions)
            graphNodes.forEach(node => {
                node.x += (node.targetX - node.x) * 0.08;
                node.y += (node.targetY - node.y) * 0.08;

                // Add soft floating effect
                if (node.id !== 'user') {
                    const time = Date.now() * 0.002;
                    const offset = (node.id.charCodeAt(node.id.length - 1) || 0) * 10;
                    node.x += Math.sin(time + offset) * 0.15;
                    node.y += Math.cos(time + offset) * 0.15;
                }

                // Draw glowing node
                gCtx.beginPath();
                gCtx.arc(node.x, node.y, node.radius, 0, 2 * Math.PI);
                gCtx.fillStyle = node.color;
                gCtx.shadowColor = node.color;
                gCtx.shadowBlur = 8;
                gCtx.fill();
                gCtx.shadowBlur = 0; // Reset shadow

                // Node label text
                gCtx.font = 'bold 9px Outfit';
                gCtx.fillStyle = '#fff';
                gCtx.textAlign = 'center';
                gCtx.fillText(node.label, node.x, node.y + node.radius + 12);
            });

            animationFrameId = requestAnimationFrame(animateGraph);
        }
    </script>
</body>

</html>